# ApolloData – environment configuration (copy to .env; never commit .env).
# Quick start on Windows:  powershell -ExecutionPolicy Bypass -File scripts/init-env.ps1
# The script copies this file and generates random POSTGRES_PASSWORD, ADMIN_PASSWORD and OTP_HASH_KEY.

# --- Web ---------------------------------------------------------------------
WEB_PORT=8080
APP_NAME=ApolloData
# Secure cookies are accepted by browsers on http://localhost. Set to false only when
# accessing the app over plain HTTP from another host (never in production).
COOKIE_SECURE=true
ASPNETCORE_ENVIRONMENT=Production
ENABLE_SWAGGER=false
REPORTING_TIME_ZONE=Europe/Prague
# Public address of the web app; used for links in notification emails (status change, new message).
APP_PUBLIC_URL=http://localhost:8080

# --- Database ----------------------------------------------------------------
POSTGRES_DB=apollodata
POSTGRES_USER=apollo
# Use letters and digits only (the value is embedded in a connection string).
POSTGRES_PASSWORD=change-me

# --- Initial administrator ------------------------------------------------------
# Created on first start if it does not exist. Never reset automatically afterwards.
# To change the password later: edit ADMIN_PASSWORD and run scripts/reset-admin.ps1
ADMIN_USERNAME=admin
# At least 12 characters. Required on first start – there is no default password.
ADMIN_PASSWORD=

# --- One-time code hashing ----------------------------------------------------------
# Optional HMAC key for login codes. If empty, a random per-process key is used
# (pending codes become invalid after an API restart).
OTP_HASH_KEY=

# --- Email (SMTP) ---------------------------------------------------------------
# Gmail: requires 2-step verification and a Google App Password (https://myaccount.google.com/apppasswords).
# Any other SMTP server works too (SMTP_USE_STARTTLS=false means implicit TLS on port 465, otherwise plain SMTP).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=your.address@gmail.com
# 16-character Google App Password (spaces may be omitted). Enter it only in your local .env.
SMTP_PASSWORD=
SMTP_FROM_EMAIL=your.address@gmail.com
SMTP_FROM_NAME=ApolloData

# --- Map (geocoding) -------------------------------------------------------------
# Clinic addresses (street, postal code, city) are sent to OpenStreetMap Nominatim to place clinics on the
# admin map (max. 1 request/second). Set to false to keep addresses local; clinics then do not appear on the map.
GEOCODING_ENABLED=true
# Optional contact e-mail passed to Nominatim, as its usage policy recommends.
GEOCODING_CONTACT_EMAIL=
